{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "get-axolotl.com"
        }
      ],
      "destination": "https://www.try-mycelium.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.get-axolotl.com"
        }
      ],
      "destination": "https://www.try-mycelium.com/:path*",
      "permanent": true
    },
    {
      "source": "/employers",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/es/employers",
      "destination": "/es",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/waitlist",
      "destination": "/api/waitlist"
    },
    {
      "source": "/api/call-me",
      "destination": "https://get-axolotl-agent-production.up.railway.app/api/call-me"
    }
  ]
}
