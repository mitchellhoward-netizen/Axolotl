        <style type="text/css">
            /* Add a media query to hide the button on mobile devices */
            @media (max-width: 768px) {
                .embeddedServiceHelpButton div.helpButton button.uiButton,
                .offlineHelpButton .offlineUiButton,
                button.sidebarHeader.minimizedContainer {
                    display: none;
                }
            }

            /* This is the header for the chat window when open */
            .sidebarHeader {
                background-color: #0F2D4A !important;
            }

            /* This is the header for the announcement that pops when open */
            .headerAnnouncement {
                background-color: #0F2D4A !important; 
            }

            .text.announcement {
                color: white !important;
            }

            .embeddedServiceHelpButton div.helpButton button.uiButton,
            .offlineHelpButton .offlineUiButton,
            button.sidebarHeader.minimizedContainer {
                background-color: #015071;
                height: 48px;
                min-width: 146px;
                width: fixed;
                outline: none;
                position: fixed;
                bottom: 0;
                right: 25px;
                z-index: 999;
            }

            .embeddedServiceHelpButton div.helpButton button.uiButton {
                background-image: url(./assets/img/linq-connect-icon.png);
                background-size: 20px;
                background-position: 9%;
                background-repeat: no-repeat;
                background-size: 25px 25px;
                box-shadow: none;
                cursor: pointer;
                overflow: auto;
            }

            .embeddedServiceHelpButton .helpButton .uiButton {
                box-sizing: border-box;
                margin: 0;
                padding: 0 12px line-height 1;
                font-size: 1em;
                display: flex;
                text-shadow: none;
                flex-direction: row;
                align-items: center;
                text-align: right;
            }

            .embeddedServiceHelpButton .helpButton {
                margin: 0;
            }

            .embeddedServiceHelpButton .helpButton .uiButton .embeddedServiceIcon {
                margin: left;
                color: #ff8823;
                text-align: center;
                overflow: visible;
                box-shadow: none;
            }

            .embeddedServiceHelpButton .embeddedServiceIcon::before {
                display: none;
            }

            .embeddedServiceHelpButton .embeddedServiceIcon::after {
                display: none;
                position: relative;
                z-index: 1;
                align-self: stretch;
                max-width: 100%;
                line-height: normal;
                overflow: hidden;
                white-space: nowrap;
                text-overflow: ellipsis;
            }

            .embeddedServiceHelpButton .helpButton .uiButton .helpButtonLabel {
                position: center;
                z-index: 1;
                align-self: stretch;
                max-width: 100%;
                line-height: normal;
                overflow: hidden;
                margin-left: 40px;
            }

            .embeddedServiceHelpButton .helpButton:not(.finished) .uiButton .helpButtonLabel {
                z-index: 1;
                max-width: 100%;
                line-height: normal;
                overflow: hidden;
                margin-left: 40px;
                transition: margin-left 0.3s;
            }

            header.sidebarHeader h2 {
                color: white;
