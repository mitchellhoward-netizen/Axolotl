# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# Optional LLM brain (OpenAI-compatible). DeepSeek is the default.
# Without a key, a deterministic offline engine is used.
DEEPSEEK_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# (Legacy OpenAI vars also work: OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL)

# Real email sending via Resend (https://resend.com). Without these, the agent
# only drafts + logs ("mock") and never truly sends.
RESEND_API_KEY=
EMAIL_FROM=your-verified-sender@yourdomain.com

# Retell voice agent (outbound calls to the school). The agent is already created;
# add RETELL_AGENT_ID + a tunnel URL for the webhook. Without these, no calls.
RETELL_API_KEY=
RETELL_AGENT_ID=              # agent_ab25169a181565338860ef43a7 (created)
RETELL_FROM_NUMBER=
RETELL_WEBHOOK_SECRET=
# Public URL where Retell can POST call events (a tunnel, e.g. ngrok/cloudflared)
WEBHOOK_PUBLIC_URL=

# Outbound SMS provider (the "you're on the waitlist" text + future texts).
# Default is Textbelt: free/cheap, no business profile or A2P registration.
# The free key "textbelt" sends 1 text/day; create your own key for more volume.
SMS_PROVIDER=textbelt           # textbelt (default) | retell
TEXTBELT_KEY=                   # optional; default "textbelt" (1/day). Paid key for more

# Retell SMS (opt-in with SMS_PROVIDER=retell). RETELL_SMS_AGENT_ID should be a
# chat-mode Retell agent whose prompt emits {{waitlist_message}}. RETELL_FROM_NUMBER
# must be SMS-enabled on Retell. RETELL_API_BASE defaults to https://api.retellai.com.
RETELL_SMS_AGENT_ID=

# Number the agent dials when the parent texts "call me" (for the demo).
CALL_ME_NUMBER=+18313459066
# Number dialed when the parent says "call the school". Leave unset to dial the
# demo number (CALL_ME_NUMBER) until you're ready to call a real school.
SCHOOL_CALL_NUMBER=

# Proactive "always-on advocate" follow-ups. The agent follows up when relevant
# but never nags: quiet hours, cooldown after the parent's last message, and a
# daily per-family cap all apply. Agent-side "chase" follow-ups never message
# the parent (the agent chases the school instead). Optional — these are the
# defaults. PROACTIVE_INTERVAL_MS controls how often the background pass runs.
PROACTIVE_INTERVAL_MS=300000
PROACTIVE_MAX_PER_DAY=1
PROACTIVE_COOLDOWN_MS=21600000
PROACTIVE_QUIET_START=22
PROACTIVE_QUIET_END=8
PROACTIVE_MAX_DUE_DAYS=14

# Postgres (Prisma). See prisma/schema.prisma and docs/ONTOLOGY.md.
DATABASE_URL=postgresql://user:password@localhost:5432/school_agent

# Knowledge-graph embeddings (pgvector). Optional — without these, retrieval falls
# back to category/keyword filtering. Set an OpenAI-compatible embeddings endpoint.
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1/embeddings

# Supabase persistence (the app reads/writes via the API — no DB password).
# Use the service_role key (backend, bypasses RLS). From Settings → API.
SUPABASE_URL=https://oclewvlfnwiwgmxlgvee.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
