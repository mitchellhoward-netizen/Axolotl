# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# Optional LLM brain (OpenAI-compatible). DeepSeek is the default.
# Without a key, a deterministic offline engine is used.
DEEPSEEK_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# (Legacy OpenAI vars also work: OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL)

# Real email sending via Resend (https://resend.com). Without these, the agent
# only drafts + logs ("mock") and never truly sends.
RESEND_API_KEY=
EMAIL_FROM=your-verified-sender@yourdomain.com

# Retell voice agent (outbound calls to the school). The agent is already created;
# add RETELL_AGENT_ID + a tunnel URL for the webhook. Without these, no calls.
RETELL_API_KEY=
RETELL_AGENT_ID=              # agent_ab25169a181565338860ef43a7 (created)
RETELL_FROM_NUMBER=
RETELL_WEBHOOK_SECRET=
# Public URL where Retell can POST call events (a tunnel, e.g. ngrok/cloudflared)
WEBHOOK_PUBLIC_URL=

# Number the agent dials when the parent texts "call me" (for the demo).
CALL_ME_NUMBER=+18313459066
# Number dialed when the parent says "call the school". Leave unset to dial the
# demo number (CALL_ME_NUMBER) until you're ready to call a real school.
SCHOOL_CALL_NUMBER=

# Postgres (Prisma). See prisma/schema.prisma and docs/ONTOLOGY.md.
DATABASE_URL=postgresql://user:password@localhost:5432/school_agent

# Supabase persistence (the app reads/writes via the API — no DB password).
# Use the service_role key (backend, bypasses RLS). From Settings → API.
SUPABASE_URL=https://oclewvlfnwiwgmxlgvee.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
